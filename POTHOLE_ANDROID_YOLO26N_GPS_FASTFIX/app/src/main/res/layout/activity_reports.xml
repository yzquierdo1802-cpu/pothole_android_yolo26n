<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.14"
                android:text="BACHES PE · EVIDENCIAS"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Galería / Reportes"
                android:textColor="@color/text_primary"
                android:textSize="25sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/backButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="0dp"
            android:text="En vivo"
            android:textAllCaps="false"
            android:textColor="@color/accent_cyan"
            app:cornerRadius="18dp"
            app:strokeColor="#31505C"
            app:strokeWidth="1dp" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="@color/bg_card"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/stroke_soft"
        app:strokeWidth="1dp">

        <TextView
            android:id="@+id/reportsSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="14dp"
            android:text="Total 0 · Baja 0 · Media 0 · Alta 0"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </com.google.android.material.card.MaterialCardView>

    <EditText
        android:id="@+id/reportSearch"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_field_dark"
        android:hint="Buscar ID, fecha, sesión o fuente"
        android:textColorHint="#60717D"
        android:inputType="text"
        android:paddingHorizontal="15dp"
        android:singleLine="true"
        android:textColor="@color/text_primary"
        android:textColorHighlight="@color/accent_cyan"
        android:textSize="13sp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/filterAllButton"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Todos"
                android:textAllCaps="false"
                app:cornerRadius="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/filterLowButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:text="Baja"
                android:textAllCaps="false"
                android:textColor="@color/severity_low"
                app:cornerRadius="16dp"
                app:strokeColor="@color/severity_low" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/filterMediumButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:text="Media"
                android:textAllCaps="false"
                android:textColor="@color/severity_medium"
                app:cornerRadius="16dp"
                app:strokeColor="@color/severity_medium" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/filterHighButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:text="Alta"
                android:textAllCaps="false"
                android:textColor="@color/severity_high"
                app:cornerRadius="16dp"
                app:strokeColor="@color/severity_high" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/filterTodayButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:text="Hoy"
                android:textAllCaps="false"
                android:textColor="@color/text_secondary"
                app:cornerRadius="16dp"
                app:strokeColor="#354A56" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/filterWeekButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:text="7 días"
                android:textAllCaps="false"
                android:textColor="@color/text_secondary"
                app:cornerRadius="16dp"
                app:strokeColor="#354A56" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/selectAllButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:text="Seleccionar todo"
            android:textAllCaps="false"
            android:textColor="@color/accent_cyan"
            app:cornerRadius="16dp"
            app:strokeColor="#2E5964" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/clearSelectionButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:text="Limpiar"
            android:textAllCaps="false"
            android:textColor="@color/text_secondary"
            app:cornerRadius="16dp"
            app:strokeColor="#354A56" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/deleteSelectedButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="7dp"
            android:layout_weight="1.15"
            android:text="Eliminar (0)"
            android:textAllCaps="false"
            android:textColor="@color/danger"
            app:cornerRadius="16dp"
            app:strokeColor="@color/danger" />
    </LinearLayout>

    <ListView
        android:id="@+id/reportsList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:divider="@android:color/transparent"
        android:dividerHeight="8dp"
        android:listSelector="@android:color/transparent"
        android:paddingBottom="10dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/exportCsvButton"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:backgroundTint="@color/cream"
            android:text="Exportar CSV"
            android:textAllCaps="false"
            android:textColor="#0A1015"
            android:textStyle="bold"
            app:cornerRadius="20dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/shareCsvButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Compartir"
            android:textAllCaps="false"
            android:textColor="@color/accent_cyan"
            app:cornerRadius="20dp"
            app:strokeColor="#2E5964" />
    </LinearLayout>
</LinearLayout>
